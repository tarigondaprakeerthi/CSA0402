#include <stdio.h>

int main() {
    int block[] = {100, 500, 200, 300};
    int process[] = {212, 417, 112};
    int i, j;

    for(i = 0; i < 3; i++) {
        for(j = 0; j < 4; j++) {
            if(block[j] >= process[i]) {
                printf("Process %d allocated to Block %d\n", i + 1, j + 1);
                block[j] -= process[i];
                break;
            }
        }
    }

    return 0;
}
