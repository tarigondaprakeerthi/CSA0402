#include <stdio.h>

int main() {
    int n, i, j, bt[10], pr[10], p[10], temp;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++) {
        p[i] = i + 1;
        printf("Burst Time and Priority of P%d: ", p[i]);
        scanf("%d %d", &bt[i], &pr[i]);
    }

    // Sort by priority (smaller number = higher priority)
    for(i = 0; i < n - 1; i++) {
        for(j = i + 1; j < n; j++) {
            if(pr[i] > pr[j]) {
                temp = pr[i]; pr[i] = pr[j]; pr[j] = temp;
                temp = bt[i]; bt[i] = bt[j]; bt[j] = temp;
                temp = p[i]; p[i] = p[j]; p[j] = temp;
            }
        }
    }

    printf("\nExecution Order:\n");
    for(i = 0; i < n; i++)
        printf("P%d ", p[i]);

    return 0;
}
