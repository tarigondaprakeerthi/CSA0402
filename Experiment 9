#include <stdio.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <string.h>

int main() {
    int shmid;
    char *data;

    shmid = shmget(1234, 100, 0666 | IPC_CREAT);
    data = (char *)shmat(shmid, NULL, 0);

    strcpy(data, "Hello Shared Memory!");

    printf("Data written: %s\n", data);

    shmdt(data);
    shmctl(shmid, IPC_RMID, NULL);

    return 0;
}
