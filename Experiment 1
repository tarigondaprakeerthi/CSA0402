#include<stdio.h>
#include<unistd.h>
#include<sys/types.h>
#include<sys/wait.h>

int main()
{
    pid_t pid;

    pid=fork();

    if(pid==0)
    {
        printf("\nChild Process");
        printf("\nChild PID : %d",getpid());
        printf("\nParent PID : %d",getppid());
    }
    else if(pid>0)
    {
        wait(NULL);
        printf("\nParent Process");
        printf("\nParent PID : %d",getpid());
    }
    else
    {
        printf("Fork Failed");
    }

    return 0;
}
