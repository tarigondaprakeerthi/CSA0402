#include<stdio.h>
#include<fcntl.h>
#include<unistd.h>

int main()
{
    int src,dst,n;
    char buffer[100];

    src=open("source.txt",O_RDONLY);

    if(src<0)
    {
        printf("Source file not found");
        return 0;
    }

    dst=open("destination.txt",O_CREAT|O_WRONLY|O_TRUNC,0644);

    while((n=read(src,buffer,sizeof(buffer)))>0)
    {
        write(dst,buffer,n);
    }

    close(src);
    close(dst);

    printf("File Copied Successfully");

    return 0;
}
